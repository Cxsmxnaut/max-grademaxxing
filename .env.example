# ── Token Mesh key pool ────────────────────────────────────────────────
# Comma-separated free developer keys. Add as many of each as you own —
# more keys = more headroom before the pool ever benches out.
# Server-side only. Never expose these to the client.
GROQ_API_KEYS=gsk_...,gsk_...
OPENROUTER_API_KEYS=sk-or-v1-...
MISTRAL_API_KEYS=...
# Google AI Studio keys — speak the OpenAI protocol via
# generativelanguage.googleapis.com/v1beta/openai (verified working).
# First key = Tier-1 primary; later keys share the same tier.
GEMINI_API_KEYS=AQ....,AQ....

# ── Optional model overrides ───────────────────────────────────────────
# Defaults: qwen/qwen3.8-27b (groq), nvidia/nemotron-3.5-lightning:free
# (openrouter), mistral-small-latest (mistral), gemini-3.8-flash (gemini).
# Note: gemini-2.5-flash is unavailable to accounts created after ~Oct 2026;
# gemini-3.8-flash is the newest model all Gemini keys can serve.
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# MISTRAL_MODEL=mistral-small-latest
# GEMINI_MODEL=gemini-3.8-flash

# ── Optional OpenRouter attribution headers ────────────────────────────
# APP_URL=https://grademaxxing.app
# APP_NAME=Grademaxxing

# ── Demo server ────────────────────────────────────────────────────────
# PORT=5199
